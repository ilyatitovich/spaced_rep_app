# Postgres
POSTGRES_USER=spaced_rep
POSTGRES_PASSWORD=spaced_rep
POSTGRES_DB=spaced_rep
# Host-published port (internal container port stays 5432)
POSTGRES_PORT=5433

# Redis
# Host-published port (internal container port stays 6379)
REDIS_PORT=6380

# Server
SERVER_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,chrome-extension://your-extension-id

# Service URLs for containers on the Compose network
# Prisma Client (inside the server container) must use hostname `postgres`, not localhost.
DATABASE_URL=postgresql://spaced_rep:spaced_rep@postgres:5432/spaced_rep
REDIS_URL=redis://redis:6379

# Google OAuth + JWT (required by server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=http://localhost:5173/oauth/google/callback
# From chrome.identity.getRedirectURL('authorized')
EXTENSION_REDIRECT_URIS=https://your-extension-id.chromiumapp.org/authorized
JWT_SECRET=dev-only-change-me-to-a-long-random-secret

# Email OTP
OTP_PEPPER=dev-only-change-me-to-a-long-otp-pepper
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=
EMAIL_FROM=SpacedRep <onboarding@resend.dev>

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SpacedRepApp
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_CHALLENGE_TTL_SECONDS=60

# Lemon Squeezy billing (server-only). Leave API key empty in development
# to grant Pro on Upgrade without calling Lemon.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_TEST_MODE=false
BILLING_RETURN_URL=http://localhost:5173/settings/subscription

# Host-side Prisma CLI (run migrate/studio from your machine against published port):
# DATABASE_URL=postgresql://spaced_rep:spaced_rep@localhost:5433/spaced_rep

# Private media bucket (Cloudflare R2 in production; MinIO locally via Compose)
# Prod: create private bucket `spaced-rep-media`, apply infra/r2/cors.json in the
# Cloudflare dashboard, and use an Object Read & Write API token (never expose to clients).
# Local Compose defaults below talk to the MinIO service (see docker-compose.yml).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Browser origins allowed to call MinIO with presigned URLs (comma-separated).
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
R2_ACCOUNT_ID=
R2_BUCKET=spaced-rep-media
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_ENDPOINT=http://minio:9000
R2_PRESIGN_ENDPOINT=http://localhost:9000
R2_REGION=us-east-1
R2_FORCE_PATH_STYLE=true
