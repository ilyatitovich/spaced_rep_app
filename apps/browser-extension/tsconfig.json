{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../client/src/*"],
      "lucide-react": ["./node_modules/lucide-react/dist/lucide-react.d.ts"],
      "react-hot-toast": ["./node_modules/react-hot-toast/dist/index.d.ts"]
    },
    "types": ["chrome", "vite/client", "vitest/globals"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../client/src/vite-env.d.ts"
  ],
  "exclude": ["wxt.config.ts", "vitest.config.ts"]
}
