{
  "name": "spaced_rep_pwa_server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project server-integration",
    "backfill:media": "tsx scripts/backfill-media.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^10.78.0",
    "@simplewebauthn/server": "^13.3.2",
    "@spaced-rep/sync-protocol": "workspace:*",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "juice": "^12.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "redis": "^6.3.1",
    "resend": "^6.37.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
