# Set VITE_API_URL to enable cloud auth/sync against the Express backend.
# Leave unset for local-only (IndexedDB, no network).
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile (test sitekey always passes)
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sentry (client DSN — public; leave unset to disable)
VITE_SENTRY_DSN=
# Optional release tag (e.g. git SHA) — set at build time in CI
VITE_APP_VERSION=

# Source map upload (build-time secrets — never commit)
# Prefer gitignored apps/client/.env.sentry-build-plugin for local release builds.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=spacedrep
# SENTRY_PROJECT=javascript-react

