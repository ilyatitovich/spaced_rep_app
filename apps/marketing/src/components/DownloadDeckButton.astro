---
import type { Deck } from '../lib/decks'

interface Props {
  deck: Deck
}

const { deck } = Astro.props
const payload = JSON.stringify(deck, null, 2)
const filename = `${deck.slug}.json`
---

<download-deck-button data-filename={filename} data-payload={payload}>
  <button
    type="button"
    class="inline-flex cursor-pointer items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-[var(--shadow-primary)] transition-colors hover:bg-primary-hover"
  >
    Download JSON
  </button>
</download-deck-button>

<script>
  import '../scripts/download-deck.ts'
</script>
