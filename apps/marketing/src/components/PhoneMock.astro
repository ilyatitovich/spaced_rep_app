---
/**
 * Static review-screen mock matching apps/client topic-test UI.
 */
---

<div
  class="animate-mock-float relative mx-auto w-[min(100%,280px)]"
  aria-hidden="true"
>
  <div
    class="relative overflow-hidden rounded-[2.4rem] border border-border bg-background shadow-[0_40px_80px_-20px_rgb(124_58_237_/0.35)]"
  >
    {/* Notch */}
    <div class="absolute inset-x-0 top-0 z-10 flex justify-center pt-3">
      <div class="h-6 w-24 rounded-full bg-foreground/90"></div>
    </div>

    <div class="flex aspect-[9/19] flex-col bg-background px-3 pb-5 pt-11">
      {/* Header: close · Back · cards left */}
      <div class="mb-3 flex items-center px-1">
        <span
          class="flex size-7 items-center justify-center rounded-full text-lg leading-none text-foreground"
          >×</span
        >
        <span class="flex-1 text-center text-[11px] font-bold text-foreground"
          >Front</span
        >
        <span class="relative flex size-7 items-center justify-center">
          <svg
            width="28"
            height="28"
            class="absolute -rotate-90"
            viewBox="0 0 32 32"
          >
            <circle
              cx="16"
              cy="16"
              r="12"
              fill="none"
              stroke-width="3"
              class="stroke-border"></circle>
            <circle
              cx="16"
              cy="16"
              r="12"
              fill="none"
              stroke-width="3"
              stroke-dasharray="75.4"
              stroke-dashoffset="28"
              stroke-linecap="round"
              class="stroke-foreground"></circle>
          </svg>
          <span class="relative text-[10px] font-medium text-foreground">8</span
          >
        </span>
      </div>

      {/* Flashcard — thick border, large radius */}
      <div
        class="mx-auto flex min-h-0 w-[88%] flex-1 flex-col items-center justify-center border-6 border-foreground rounded-[1.35rem] bg-card px-3 py-4 shadow-sm"
      >
        <p
          class="font-card text-center text-[15px] font-normal leading-snug text-card-foreground"
        >
          What makes spacing better than cramming?
        </p>
      </div>

      {/* Answer buttons — Wrong / Correct */}
      <div class="mt-3 flex gap-2 px-1">
        <span
          class="flex-1 rounded-xl bg-linear-to-br from-danger to-danger-hover py-2.5 text-center text-[10px] font-black text-primary-foreground shadow-md"
        >
          Wrong
        </span>
        <span
          class="flex-1 rounded-xl bg-linear-to-br from-success to-success-hover py-2.5 text-center text-[10px] font-black text-primary-foreground shadow-md"
        >
          Correct
        </span>
      </div>
    </div>
  </div>
</div>
