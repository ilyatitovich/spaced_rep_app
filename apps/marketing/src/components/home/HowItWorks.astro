---
const steps = [
  {
    n: '01',
    title: 'Add cards',
    body: 'Capture facts, phrases, or concepts into topics as you learn — from reading, lectures, or your own notes.',
  },
  {
    n: '02',
    title: 'Review in short sessions',
    body: 'When a card is due, say whether you remembered it. Keep sessions short so you come back tomorrow.',
  },
  {
    n: '03',
    title: 'Spacing does the rest',
    body: 'Remembered cards climb seven levels and return less often. Forgotten ones reset so the memory rebuilds.',
  },
]
---

<section id="how-it-works" class="border-t border-border-muted py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-foreground-accent">
      How it works
    </p>
    <h2 class="mt-3 max-w-xl font-display text-3xl font-bold text-foreground sm:text-4xl">
      Three steps. Then show up.
    </h2>
    <ol class="mt-12 grid gap-10 sm:grid-cols-3">
      {
        steps.map((step) => (
          <li>
            <span class="font-display text-sm font-bold text-foreground-accent">{step.n}</span>
            <h3 class="mt-2 font-display text-xl font-bold text-foreground">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-foreground-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
