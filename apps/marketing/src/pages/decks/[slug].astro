---
import { PRODUCT_NAME } from '@spaced-rep/brand'
import BaseLayout from '../../layouts/BaseLayout.astro'
import DownloadDeckButton from '../../components/DownloadDeckButton.astro'
import { deckCardCount, getAllDecks, getDeck } from '../../lib/decks'

export function getStaticPaths() {
  return getAllDecks().map((deck) => ({
    params: { slug: deck.slug },
  }))
}

const { slug } = Astro.params
const deck = getDeck(slug ?? '')

if (!deck) {
  throw new Error(`Unknown deck: ${slug}`)
}
---

<BaseLayout title={deck.title} description={deck.description}>
  <section class="mx-auto max-w-2xl px-5 py-16 sm:px-8">
    <p class="text-sm text-muted-foreground">
      <a href="/decks" class="no-underline hover:text-foreground-accent">Shared cards</a>
      <span class="mx-2 text-foreground-subtle">/</span>
      {deckCardCount(deck)} cards
    </p>
    <h1 class="mt-4 font-display text-4xl font-bold text-foreground">{deck.title}</h1>
    <p class="mt-3 text-foreground-muted">{deck.description}</p>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <DownloadDeckButton deck={deck} />
      <p class="text-sm text-foreground-muted">
        Import the JSON in {PRODUCT_NAME} under Data & Sync when you are ready.
      </p>
    </div>
    <ul class="mt-12 space-y-4">
      {
        deck.cards.map((card, index) => (
          <li class="rounded-xl bg-card p-4 ring-1 ring-border-muted">
            <p class="text-xs font-semibold uppercase tracking-wider text-foreground-accent">
              Card {index + 1}
            </p>
            <p class="mt-2 font-semibold text-card-foreground">{card.front}</p>
            <p class="mt-2 text-sm text-foreground-muted">{card.back}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
