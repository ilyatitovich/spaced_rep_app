---
import { PRODUCT_NAME } from '@spaced-rep/brand'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { deckCardCount, getAllDecks } from '../../lib/decks'

const decks = getAllDecks()
---

<BaseLayout
  title="Shared cards"
  description={`Curated starter decks you can download and import into ${PRODUCT_NAME}.`}
>
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <h1 class="font-display text-4xl font-bold text-foreground">Shared cards</h1>
    <p class="mt-3 text-foreground-muted">
      Simple curated decks for v1 — browse, download JSON, then import in {PRODUCT_NAME}. No
      accounts, uploads, or ratings yet.
    </p>
    <ul class="mt-12 space-y-6">
      {
        decks.map((deck) => (
          <li class="rounded-2xl bg-card p-6 ring-1 ring-border-muted">
            <h2 class="font-display text-xl font-bold">
              <a
                href={`/decks/${deck.slug}`}
                class="text-card-foreground no-underline hover:text-foreground-accent"
              >
                {deck.title}
              </a>
            </h2>
            <p class="mt-2 text-sm text-foreground-muted">{deck.description}</p>
            <p class="mt-3 text-xs text-muted-foreground">
              {deckCardCount(deck)} cards
              {deck.tags.length > 0 && (
                <>
                  <span class="mx-2 text-foreground-subtle">·</span>
                  {deck.tags.join(', ')}
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
