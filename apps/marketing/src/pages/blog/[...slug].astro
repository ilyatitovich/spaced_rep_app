---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-2xl px-5 py-16 sm:px-8">
    <p class="text-sm text-muted-foreground">
      <a href="/blog" class="no-underline hover:text-foreground-accent">Blog</a>
      <span class="mx-2 text-foreground-subtle">/</span>
      {formatDate(post.data.pubDate)}
    </p>
    <h1 class="mt-4 font-display text-4xl font-bold text-balance text-foreground">
      {post.data.title}
    </h1>
    <p class="mt-4 text-lg text-foreground-muted">{post.data.description}</p>
    <div
      class="prose-marketing mt-10 space-y-4 text-[1.05rem] leading-relaxed text-foreground [&_a]:text-foreground-accent [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-foreground [&_li]:ml-5 [&_li]:list-disc [&_ol]:space-y-2 [&_p]:text-pretty [&_strong]:text-foreground [&_ul]:space-y-2"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
