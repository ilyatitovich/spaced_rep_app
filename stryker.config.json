{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate_comment": "Core sync, study grading, and auth logic with unit coverage. leitner-schedule is excluded until its mutant survival rate is fixed. Thresholds from a measured 2026-11 run; break fails nightly if score drops.",
  "mutate": [
    "apps/client/src/lib/study.ts",
    "apps/client/src/lib/get-today.ts",
    "apps/client/src/models/day.model.ts",
    "apps/server/src/auth/lib/auth-user.ts",
    "apps/server/src/auth/services/turnstile.service.ts",
    "apps/server/src/sync/mutation-validation.ts",
    "packages/sync-protocol/src/codec.ts",
    "packages/sync-protocol/src/cursor.ts",
    "packages/sync-protocol/src/wire-media.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  },
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "concurrency": 4
}
