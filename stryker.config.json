{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate_comment": "App and package sources are not in a root src/. Exclusions match the Stryker default, plus declaration files and the generated Prisma client.",
  "mutate": [
    "{apps,packages}/*/{src,entrypoints}/**/!(*.+(s|S)pec|*.+(t|T)est).+(cjs|mjs|js|ts|mts|cts|jsx|tsx|html|vue|svelte)",
    "!{apps,packages}/*/{src,entrypoints}/**/__tests__/**/*.+(cjs|mjs|js|ts|mts|cts|jsx|tsx|html|vue|svelte)",
    "!**/*.d.ts",
    "!**/generated/**"
  ]
}
