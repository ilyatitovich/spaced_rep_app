{
  "name": "spaced_repetition_app",
  "author": "Ilya Titov",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* dev",
    "build": "pnpm -r build",
    "vercel-build": "pnpm --filter spaced_rep_pwa_client build",
    "typecheck": "pnpm -r typecheck && pnpm test:testing:typecheck",
    "lint": "oxlint . && node scripts/ratchet-non-null.mjs",
    "lint:fix": "oxlint --fix .",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "knip": "knip",
    "jscpd": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prisma:generate": "pnpm --filter spaced_rep_pwa_server prisma:generate",
    "prisma:migrate": "pnpm --filter spaced_rep_pwa_server prisma:migrate",
    "prisma:migrate:deploy": "pnpm --filter spaced_rep_pwa_server prisma:migrate:deploy",
    "prisma:studio": "pnpm --filter spaced_rep_pwa_server prisma:studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:perf": "node --expose-gc testing/perf/deck-heap.mjs && node testing/perf/sync-latency.mjs && node testing/perf/bundle-budget.mjs",
    "test:perf:lighthouse": "node testing/perf/lighthouse-smoke.mjs",
    "test:unit": "vitest run --project client --project server --project sync-protocol --project sync-client --project browser-extension --project testing",
    "test:integration": "vitest run --project server-integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:ci": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:db:prepare": "pnpm --filter spaced_rep_pwa_server exec tsx ../../testing/scripts/prepare-db.ts",
    "test:testing:typecheck": "tsc -p testing/tsconfig.json --noEmit",
    "test:doc:check": "remark . --frail"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.64.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^25.9.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.4.2",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "redis": "^6.3.1",
    "remark-cli": "^12.0.1",
    "remark-lint-heading-capitalization": "^1.3.0",
    "supertest": "^7.3.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
